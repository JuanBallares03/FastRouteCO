{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.test": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.test": "allow"
    },
    "bash": {
      "rm *": "ask",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "Remove-Item *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny"
    }
  },
  "mcp": {
    "drawio": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@drawio/mcp"],
      "timeout": 20000
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "timeout": 20000
    },
    "codegraphcontext": {
      "enabled": false,
      "type": "local",
      "command": ["cgc", "mcp", "start"]
    },
    "composio": {
      "enabled": false,
      "type": "remote",
      "url": "https://connect.composio.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "mermaid": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "mcp-mermaid"],
      "timeout": 20000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Readonly": "true"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "DATABASE_URI", "crystaldba/postgres-mcp", "--access-mode=restricted"],
      "enabled": true,
      "environment": {
        "DATABASE_URI": "{env:FASTROUTE_DB_URI}"
      }
    }
  }
}