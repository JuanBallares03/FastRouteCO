{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.test": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.test": "allow"
    }
  },
  "mcp": {
    "drawio": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@drawio/mcp"],
      "timeout": 20000
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest"],
      "timeout": 20000
    },
    "codegraphcontext": {
      "enabled": false,
      "type": "local",
      "command": ["cgc", "mcp", "start"]
    },
    "composio": {
      "enabled": false,
      "type": "remote",
      "url": "https://connect.composio.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "mermaid": {
      "enabled": false,
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "mcp-mermaid"],
      "timeout": 20000
    }
  }
}
