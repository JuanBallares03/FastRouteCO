# Development geocoding only. Production uses the self-hosted Nominatim from docker-compose.prod.yml.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FastRouteCO/1.0
# Geocoding bounding box: left,top,right,bottom around Ibagué/Tolima.
NOMINATIM_VIEWBOX=-75.35,4.60,-75.05,4.30
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_AVG_SPEED_KMH=25
ROUTING_ROAD_FACTOR=1.3
DEMO_ADMIN_PASSWORD=
DEMO_DRIVER_PASSWORD=