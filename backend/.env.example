DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fastrouteco?schema=public
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
